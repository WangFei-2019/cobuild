# 先把域名解析到服务器，再设置这两个值。
COBUILD_DOMAIN=cobuild.example.com
COBUILD_PUBLIC_URL=https://cobuild.example.com
# Registry deployment only: replace with the digest printed by Publish CoBuild image.
# COBUILD_IMAGE=ghcr.io/owner/repository@sha256:REPLACE_WITH_DIGEST

# 可稍后配置。仅在主动请求 AI 规划时把项目需求发给该服务。
COBUILD_AI_BASE_URL=
COBUILD_AI_MODEL=
COBUILD_AI_RESPONSE_FORMAT=json_schema
COBUILD_AI_TOKEN_PARAMETER=max_completion_tokens
COBUILD_AI_TIMEOUT_MS=30000
COBUILD_AI_MAX_TOKENS=6000
# 可选 enabled/disabled；留空不发送该参数，按模型服务默认行为运行。
COBUILD_AI_THINKING=

# 密钥分别放在 .secrets/setup_token 和 .secrets/ai_api_key。
# 不要将密钥提交到 Git 或写进前端代码。
